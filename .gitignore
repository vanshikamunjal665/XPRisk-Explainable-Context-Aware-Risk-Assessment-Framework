# ---------------------------------------------------------------------------
# XPRisk - Explainable Context-Aware Risk Assessment Framework
# Git ignore rules. Tuned for Windows-first development (PowerShell, VS Code)
# while remaining cross-platform.
# ---------------------------------------------------------------------------

# --- Secrets & local configuration -----------------------------------------
# .env.example IS tracked; .env is NEVER tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Real secret material must never be committed.
#
# These patterns are deliberately ANCHORED (leading slash). An earlier,
# unanchored `secrets/` rule here also matched the labelled Phase 3 fixture
# directory `demo-app/scenarios/*/secrets/`, so git silently excluded those
# files. That left the Gitleaks integration (Phase 4) with a documented scan
# target that did not exist, and no test could catch it because the scanner
# tests mock `subprocess.run`.
#
# If you add another real secret directory, list it here explicitly. Do NOT
# replace this block with a bare `secrets/` rule.
/secrets/
/backend/secrets/
/app/secrets/
/demo-app/secrets/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments --------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# --- pytest / coverage -----------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Type checkers / linters ----------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# --- Scanner output & generated reports ------------------------------------
# Raw scanner JSON is machine-generated. Never commit it: it is large, it is
# environment specific, and it can contain fragments of matched secrets.
reports/*
!reports/.gitkeep
!reports/README.md

# Phase 9 comparative study results are a tracked research artefact: small,
# deterministic, path-free, and cited as evidence in docs/risk-model.md §9.
# Everything else in reports/ stays ignored because it is machine-generated.
!reports/comparative_study_results.json

*.sarif

# Trivy / Checkov / Gitleaks default output names
trivy-report.json
checkov-report.json
gitleaks-report.json
checkov-results*.json
checkov-*.sarif
trivy-*.json

# --- Test & tool caches ----------------------------------------------------
.cache/
node_modules/
.streamlit/secrets.toml

# --- IDEs ------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.code-workspace

# --- OS noise --------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS / Linux
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fuse_hidden*
# Linux
.directory

# --- Logs & databases ------------------------------------------------------
*.log
logs/
*.db
*.sqlite
*.sqlite3
*.db-journal

# --- Terraform -------------------------------------------------------------
# Provider plugins are large binaries and are restored by `terraform init`.
# The lock file IS tracked, because it is what makes provider versions
# reproducible across machines.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan
*.tfplan

# Local variable files may hold real values. Only *.tfvars.example is tracked.
!*.tfvars.example
# ===========================================================================
# XPRisk - Explainable Context-Aware Risk Assessment Framework
# EXAMPLE environment file.
#
# HOW TO USE
#   PowerShell :  Copy-Item .env.example .env
#   bash       :  cp .env.example .env
#
#   .env is git-ignored. NEVER commit real credentials.
#   Every value below is either empty or a harmless local placeholder.
#
# NOTE ON RISK MODEL VALUES
#   The severity weights, context multipliers, score anchors and decision
#   thresholds shown here are the SAME defaults compiled into
#   risk_engine/settings.py. They are overridable so that the comparative
#   study (severity-only vs severity+count vs XPRisk context-aware) can be
#   run without touching code. See docs/risk-model.md for the rationale.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. APPLICATION
# ---------------------------------------------------------------------------
APP_NAME="XPRisk"
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list, or "*" for any origin. Keep it explicit.
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# 2. DATABASE
# ---------------------------------------------------------------------------
# The application targets PostgreSQL. SQLite is supported ONLY as a zero
# setup fallback for local development and automated tests.
#   PostgreSQL (primary) : postgresql+psycopg2://xprisk:xprisk_dev_password@localhost:5432/xprisk
#   SQLite (dev / tests) : sqlite:///./xprisk_dev.db
DATABASE_URL=sqlite:///./xprisk_dev.db
SQL_ECHO=false

# Used by docker-compose to initialise the postgres service.
POSTGRES_USER=xprisk
POSTGRES_PASSWORD=xprisk_dev_password
POSTGRES_DB=xprisk
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# 3. SCANNER ORCHESTRATION
# ---------------------------------------------------------------------------
SCAN_TIMEOUT_SECONDS=900
# Master switch. When false, POST /scan returns 503 instead of running tools.
SCANNERS_ENABLED=true

# CRITICAL SAFETY SWITCH.
# false = a scanner whose executable is missing is reported as UNAVAILABLE
#         and the scan continues with the other tools (production default).
# true  = missing scanner falls back to a labelled fixture from fixtures/.
#         Intended for CI and for offline development ONLY.
ALLOW_FIXTURE_FALLBACK=false

# Explicitly opt individual scanners in or out.
ENABLE_TRIVY=true
ENABLE_CHECKOV=true
ENABLE_GITLEAKS=true
ENABLE_SONARQUBE=true

# ---------------------------------------------------------------------------
# 4. TRIVY  (container / filesystem / repository vulnerability scanning)
# ---------------------------------------------------------------------------
TRIVY_EXECUTABLE=trivy
# image  : scan a container image          (requires a running Docker daemon)
# fs     : scan a local filesystem path   (no Docker daemon required)
# repo   : scan a remote git repository
TRIVY_TARGET_TYPE=fs
TRIVY_IMAGE=xprisk-demo-app:latest
TRIVY_SCAN_PATH=./demo-app
TRIVY_SEVERITIES=CRITICAL,HIGH,MEDIUM,LOW
# Skip findings without a known fix. false keeps every vulnerability.
TRIVY_SKIP_FIXABLE_ONLY=false
TRIVY_OFFLINE_MODE=false
# Cache the vulnerability database between runs (speeds up repeat scans).
TRIVY_CACHE_DIR=.trivy-cache
TRIVY_INSECURE=false

# ---------------------------------------------------------------------------
# 5. CHECKOV  (infrastructure-as-code scanning)
# ---------------------------------------------------------------------------
CHECKOV_EXECUTABLE=checkov
CHECKOV_FRAMEWORK=terraform
CHECKOV_SCAN_PATH=./infrastructure
CHECKOV_BASELINE=
CHECKOV_SKIP_CHECKS=
CHECKOV_DOWNLOAD_EXTERNAL_MODULES=false
# Checkov frequently reports no severity. When true, XPRisk applies its own
# documented severity policy instead of defaulting everything to MEDIUM.
CHECKOV_USE_XPRISK_SEVERITY_POLICY=true

# ---------------------------------------------------------------------------
# 6. GITLEAKS  (secret detection)
# ---------------------------------------------------------------------------
GITLEAKS_EXECUTABLE=gitleaks
GITLEAKS_SCAN_PATH=./demo-app
# git  : scan git history (requires a git repository)
# dir  : scan the filesystem without git history
GITLEAKS_SCAN_MODE=dir
# Extended rules so our deliberately fake, labelled test secrets are
# detected deterministically by a REAL gitleaks run.
GITLEAKS_CONFIG=./fixtures/gitleaks/gitleaks.toml
GITLEAKS_REDACT=true

# ---------------------------------------------------------------------------
# 7. SONARQUBE  (static analysis: code quality + code security)
# ---------------------------------------------------------------------------
SONARQUBE_ENABLED=true
SONARQUBE_URL=http://localhost:9000
SONARQUBE_PROJECT_KEY=xprisk-demo-app
# LEAVE EMPTY. Supply via environment variable or .env, never in code.
# SonarQube: My Account -> Security -> Generate Token.
SONARQUBE_TOKEN=
SONARQUBE_API_VERSION=v2
# Seconds to wait for a background CE analysis task to finish.
SONARQUBE_TASK_TIMEOUT_SECONDS=300
# Only these SonarQube severities are imported: BLOCKER,CRITICAL,MAJOR,MINOR,INFO
SONARQUBE_SEVERITIES=BLOCKER,CRITICAL,MAJOR,MINOR,INFO
SONARQUBE_INCLUDE_TYPES=VULNERABILITY,CODE_SMELL,SECURITY_HOTSPOT
SONARQUBE_ONLY_NEW=false

# ---------------------------------------------------------------------------
# 8. RISK MODEL  (mirrors risk_engine/settings.py defaults)
# ---------------------------------------------------------------------------
# Base severity weights.
XPRISK_WEIGHT_CRITICAL=10
XPRISK_WEIGHT_HIGH=7
XPRISK_WEIGHT_MEDIUM=4
XPRISK_WEIGHT_LOW=1
XPRISK_WEIGHT_INFO=0

# Deployment environment multipliers.
XPRISK_ENV_DEVELOPMENT=1.0
XPRISK_ENV_STAGING=1.15
XPRISK_ENV_PRODUCTION=1.4

# Exposure multipliers.
XPRISK_EXPOSURE_INTERNAL=1.0
XPRISK_EXPOSURE_INTERNET_FACING=1.25

# Change status multipliers (new findings weigh more than pre-existing ones).
XPRISK_CHANGE_EXISTING=1.0
XPRISK_CHANGE_NEW=1.15

# Resource category multipliers.
XPRISK_CATEGORY_SOURCE_CODE=1.0
XPRISK_CATEGORY_SECRET=1.3
XPRISK_CATEGORY_CONTAINER=1.2
XPRISK_CATEGORY_IAC=1.1

# Raw-risk-points -> base-score anchors, interpolated piecewise-linearly and
# saturated at 100. Format: raw_points:base_score,...
XPRISK_SCORE_ANCHORS=0:0,8:10,20:30,45:55,80:75,140:90,220:100

# Upper bound applied after the context multiplier is applied to the base.
XPRISK_CONTEXT_UPLIFT_CAP=1.6

# Decision thresholds (inclusive upper bound of each band).
XPRISK_THRESHOLD_SAFE=30
XPRISK_THRESHOLD_WARNING=70

# Severity policy for tools that report no severity of their own
# (Gitleaks). Comma-separated rule-name-substring:severity pairs.
# First matching substring wins; DEFAULT_SEVERITY is the fallback.
XPRISK_GITLEAKS_DEFAULT_SEVERITY=HIGH
XPRISK_GITLEAKS_SEVERITY_RULES=private-key:CRITICAL,aws-access-key:CRITICAL,aws-secret-key:CRITICAL,slack-token:CRITICAL,stripe:CRITICAL,github-pat:CRITICAL,generic-api-key:MEDIUM,xprisk-test-secret:HIGH

# Fallback severity for Checkov checks that report severity = null.
XPRISK_CHECKOV_NULL_SEVERITY=MEDIUM

# ---------------------------------------------------------------------------
# 9. DASHBOARD
# ---------------------------------------------------------------------------
DASHBOARD_API_URL=http://127.0.0.1:8000
DASHBOARD_TITLE="XPRisk - Explainable Context-Aware Risk Assessment"
STREAMLIT_SERVER_PORT=8501
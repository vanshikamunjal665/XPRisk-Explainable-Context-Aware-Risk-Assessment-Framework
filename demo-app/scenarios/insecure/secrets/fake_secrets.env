# ===========================================================================
# XPRisk Phase 3 - INTENTIONALLY INSECURE secret fixture (Gitleaks target).
#
#   EVERY VALUE IN THIS FILE IS FAKE. NOT ONE IS A REAL CREDENTIAL.
#
#   These strings exist only so that Gitleaks has a deterministic scan
#   target during Phase 4. They are deliberately obvious placeholders.
#   Nothing here is imported or executed by the demo application or by the
#   XPRisk backend. Never reuse any of these values anywhere real.
#
#   A real `gitleaks dir` run against this directory using
#   fixtures/gitleaks/gitleaks.toml reports exactly TWO findings:
#
#     xprisk-test-secret   (custom rule below)
#     private-key          (upstream rule, PEM header further down)
#
#   All three XPRISK_TEST_* assignments below match the custom rule, but
#   Gitleaks reports only the FIRST match per rule per file. Three labelled
#   secrets therefore yield one finding. That is expected tool behaviour,
#   not a miscount.
# ===========================================================================
TEST_ONLY_GITHUB_PAT=ghp_xpriskTestOnly0000000000000000000000000
TEST_ONLY_AWS_ACCESS_KEY_ID=AKIAXPRISKTESTONLY00000
TEST_ONLY_SLACK_TOKEN=xoxb-000000000000-000000000000-XpriskTestOnlyFake000

# --- Labelled test secrets -------------------------------------------------
# Readable on purpose: these match the custom `xprisk-test-secret` rule in
# fixtures/gitleaks/gitleaks.toml, not any upstream entropy-based rule.
#
# The three shape-recognisable values above are NOT flagged by upstream
# Gitleaks 8.30.1, which is expected: upstream rules are tuned against real
# credentials and reject obvious placeholders.
XPRISK_TEST_SECRET=demo-only-not-a-real-secret
XPRISK_TEST_API_TOKEN=demo-only-not-a-real-token
XPRISK_TEST_DB_PASSWORD=demo-only-not-a-real-password

# --- Fake private key block -----------------------------------------------
# The upstream `private-key` rule keys off the PEM header, not off entropy.
# The base64 body below is a truncated placeholder and decodes to nothing.
XPRISK_TEST_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIBOgIBAAJBAKj34GkxFhD90vcNLYLInFEX6Ppy1tPf9Cnzj4p4WGeKLs1Pt8Qu
KUpRKfFLfRYC9AIKjbJTWit+CqvjWYzvQwECAwEAAQJAIJLixBy2qpFoS4DSmoEm
o3qGy0t6z09AIJtH+5OeRV1be+N4cDYJKffGzDa88vQENZiRm0GRq6a+HPGQMd2k
-----END RSA PRIVATE KEY-----"
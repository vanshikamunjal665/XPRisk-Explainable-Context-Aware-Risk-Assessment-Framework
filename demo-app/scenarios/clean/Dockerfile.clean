# XPRisk Phase 3 - CLEAN container counterpart.
#
# Uses a current, maintained, minimal base image so that Trivy is expected
# to report few or no HIGH/CRITICAL CVEs relative to Dockerfile.vulnerable.
# This is a hardening counterpart fixture, not the production demo image
# (which lives at demo-app/Dockerfile).

FROM python:3.12-slim-bookworm

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

CMD ["python", "-m", "app.main"]

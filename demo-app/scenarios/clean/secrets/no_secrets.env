# ===========================================================================
# XPRisk Phase 3 - CLEAN secret fixture (Gitleaks negative target).
#
#   This file is the structural counterpart to
#   ../insecure/secrets/fake_secrets.env. It deliberately contains NO
#   detectable secret, so a real Gitleaks scan of this directory must report
#   zero findings. That is what makes it useful: it proves the scanner is
#   genuinely detecting things rather than always reporting noise.
#
#   Values below are either empty, obviously non-secret, or indirections to
#   real environment variables.
# ===========================================================================

# Deliberately empty - assigned, but with no secret-shaped value.
XPRISK_TEST_SECRET=
XPRISK_TEST_API_TOKEN=
XPRISK_TEST_DB_PASSWORD=

# No inline value: read from the real environment at runtime.
GITHUB_TOKEN=${GITHUB_TOKEN}

# Structural counterparts of the fake PAT / AWS key in the insecure fixture,
# present but carrying no value at all.
GITHUB_PAT=
AWS_ACCESS_KEY_ID=

# Documentation-only references. There is no assignment here, so no secret
# rule can match. A scan of this directory must report zero findings.